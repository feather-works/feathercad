{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FeatherCAD",
  "version": "0.1.0",
  "identifier": "br.feathercad.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FeatherCAD",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ponte: http://ponte.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "nsis", "msi"],
    "category": "public.app-category.graphics-design",
    "shortDescription": "CAD 2D com DXF e formato próprio eficiente",
    "longDescription": "FeatherCAD — CAD 2D da suíte FeatherOffice. Motor em Rust, lê e grava DXF, formato próprio .fcdz. Sem conta e sem telemetria.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "languages": ["PortugueseBR", "English"], "displayLanguageSelector": false }
    },
    "fileAssociations": [
      { "ext": ["fcdz"], "name": "Desenho do FeatherCAD", "description": "Desenho do FeatherCAD", "mimeType": "application/x-feathercad", "role": "Editor" },
      { "ext": ["dxf"], "name": "Desenho DXF", "mimeType": "image/vnd.dxf", "role": "Editor" }
    ]
  }
}
